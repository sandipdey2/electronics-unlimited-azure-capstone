{
  "properties": {
    "displayName": "Restrict VM sizes to B-series",
    "description": "Restricts virtual machine sizes to B-series only.",
    "mode": "Indexed",
    "parameters": {},
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Compute/virtualMachines"
          },
          {
            "not": {
              "field": "Microsoft.Compute/virtualMachines/sku.name",
              "like": "Standard_B*"
            }
          }
        ]
      },
      "then": {
        "effect": "deny"
      }
    }
  }
}
